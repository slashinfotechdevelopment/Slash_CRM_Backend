// -----------------------------------------------------------------------------
// PHASE 6.3.2: TASK MANAGEMENT & ASSIGNMENT
// -----------------------------------------------------------------------------

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  IN_REVIEW
  REOPENED
  COMPLETED
  CANCELLED
}

model TaskCodeSequence {
  id         String   @id @default(cuid()) @db.VarChar(30)
  prefix     String   @unique @db.VarChar(10)
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("task_code_sequences")
}

model Task {
  id             String       @id @default(cuid()) @db.VarChar(30)
  taskCode       String       @unique @map("task_code") @db.VarChar(30)
  title          String       @db.VarChar(255)
  description    String       @db.Text
  priority       TaskPriority @default(MEDIUM) @map("priority")
  status         TaskStatus   @default(TODO) @map("status")
  category       String       @default("GENERAL") @map("category") @db.VarChar(50)
  progress       Int          @default(0) @map("progress")
  startDate      DateTime     @map("start_date") @db.Date
  dueDate        DateTime?    @map("due_date") @db.Date
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(6, 2)

  // Ownership & Assignment
  createdById  String    @map("created_by_id") @db.VarChar(30)
  assigneeId   String?   @map("assignee_id") @db.VarChar(30)
  assignedById String?   @map("assigned_by_id") @db.VarChar(30)
  assignedAt   DateTime? @map("assigned_at") @db.DateTime(0)
  departmentId String    @map("department_id") @db.VarChar(30)

  // Soft Delete & Timestamps
  deletedAt DateTime? @map("deleted_at") @db.DateTime(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  // Relations
  createdByUser  User       @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignedByUser User?      @relation("TaskAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // RESTRICT: Hard deletion of Task blocked if historical records exist
  assignmentHistory      TaskAssignmentHistory[]
  statusHistory          TaskStatusHistory[]
  activityLogs           TaskActivityLog[]
  timeEntries            TaskTimeEntry[]
  timePauses             TaskTimePause[]
  timeCorrectionRequests TaskTimeCorrectionRequest[]
  reviews                TaskReview[]
  comments               TaskComment[]

  // CASCADE: Ephemeral metadata
  tagMappings TaskTagMapping[]

  @@index([status], map: "idx_tasks_status")
  @@index([assigneeId], map: "idx_tasks_assignee")
  @@index([departmentId], map: "idx_tasks_department")
  @@index([createdById], map: "idx_tasks_creator")
  @@index([deletedAt], map: "idx_tasks_deleted")
  @@index([startDate], map: "idx_tasks_start_date")
  @@index([dueDate], map: "idx_tasks_due_date")
  @@map("tasks")
}

model TaskAssignmentHistory {
  id                 String   @id @default(cuid()) @db.VarChar(30)
  taskId             String   @map("task_id") @db.VarChar(30)
  previousAssigneeId String?  @map("previous_assignee_id") @db.VarChar(30)
  newAssigneeId      String?  @map("new_assignee_id") @db.VarChar(30)
  assignedById       String   @map("assigned_by_id") @db.VarChar(30)
  reason             String?  @db.VarChar(500)
  assignedAt         DateTime @default(now()) @map("assigned_at") @db.DateTime(0)

  task             Task  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  previousAssignee User? @relation("TaskPrevAssignee", fields: [previousAssigneeId], references: [id], onDelete: SetNull)
  newAssignee      User? @relation("TaskNewAssignee", fields: [newAssigneeId], references: [id], onDelete: SetNull)
  assignedByUser   User  @relation("TaskHistoryAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([taskId], map: "idx_assignment_history_task")
  @@index([newAssigneeId], map: "idx_assignment_history_new_assignee")
  @@map("task_assignment_histories")
}

model TaskStatusHistory {
  id             String      @id @default(cuid()) @db.VarChar(30)
  taskId         String      @map("task_id") @db.VarChar(30)
  previousStatus TaskStatus? @map("previous_status")
  newStatus      TaskStatus  @map("new_status")
  changedById    String      @map("changed_by_id") @db.VarChar(30)
  comment        String?     @db.VarChar(500)
  createdAt      DateTime    @default(now()) @map("created_at")

  task          Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  changedByUser User @relation("TaskStatusChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([taskId], map: "idx_status_history_task")
  @@map("task_status_histories")
}

model TaskActivityLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  taskId      String   @map("task_id") @db.VarChar(30)
  performedBy String   @map("performed_by") @db.VarChar(30)
  action      String   @db.VarChar(50)
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  task  Task @relation(fields: [taskId], references: [id], onDelete: Restrict)
  actor User @relation("TaskActivityActor", fields: [performedBy], references: [id], onDelete: Restrict)

  @@index([taskId], map: "idx_activity_log_task")
  @@map("task_activity_logs")
}

model TaskTag {
  id        String   @id @default(cuid()) @db.VarChar(30)
  name      String   @unique @map("name") @db.VarChar(50)
  color     String?  @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  tasks TaskTagMapping[]

  @@map("task_tags")
}

model TaskTagMapping {
  id        String   @id @default(cuid()) @db.VarChar(30)
  taskId    String   @map("task_id") @db.VarChar(30)
  tagId     String   @map("tag_id") @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at")

  task Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  TaskTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId], map: "uq_task_tag_mapping")
  @@index([tagId], map: "idx_tag_mapping_tag")
  @@map("task_tag_mappings")
}

// =============================================================================
// TASK TIME TRACKING & WORK INTERVAL SUBSYSTEM (Phase 6.3.3)
// =============================================================================

enum TaskTimerStatus {
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
}

enum DeviceType {
  WEB
  MOBILE
  DESKTOP
  SYSTEM
}

enum TaskPauseReason {
  TEA_BREAK
  LUNCH
  PERSONAL_WORK
  MEETING
  WAITING
  TECHNICAL_ISSUE
  OTHER
  TASK_SWITCH
  LOGOUT
  TASK_STATUS_CHANGE
}

enum TaskTimeCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TaskTimeEntry {
  id                  String                      @id @default(cuid()) @db.VarChar(30)
  taskId              String                      @map("task_id") @db.VarChar(30)
  userId              String                      @map("user_id") @db.VarChar(30)
  attendanceSessionId String?                     @map("attendance_session_id") @db.VarChar(30)
  workDate            DateTime                    @map("work_date") @db.Date
  startedAt           DateTime                    @map("started_at") @db.DateTime(0)
  endedAt             DateTime?                   @map("ended_at") @db.DateTime(0)
  durationSeconds     Int                         @default(0) @map("duration_seconds")
  status              TaskTimerStatus             @default(RUNNING) @map("status")
  deviceType          DeviceType                  @default(WEB) @map("device_type")
  ipAddress           String?                     @map("ip_address") @db.VarChar(45)
  userAgent           String?                     @map("user_agent") @db.VarChar(255)

  // Correction & Supersession
  isCorrection        Boolean                     @default(false) @map("is_correction")
  isSuperseded        Boolean                     @default(false) @map("is_superseded")
  supersededById      String?                     @map("superseded_by_id") @db.VarChar(30)
  correctionRequestId String?                     @unique(map: "uq_task_time_entry_correction_request") @map("correction_request_id") @db.VarChar(30)

  // Custom SQL Generated Column (STORED): Guarantees at most 1 RUNNING entry per employee
  activeUserId        String?                     @unique(map: "uq_one_running_timer_per_user") @map("active_user_id") @db.VarChar(30)

  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  task                Task                        @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                User                        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy        TaskTimeEntry?              @relation("TimeEntrySupersession", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededEntries   TaskTimeEntry[]             @relation("TimeEntrySupersession")
  correctionRequest   TaskTimeCorrectionRequest?  @relation("CorrectionResultEntry", fields: [correctionRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  originalForRequests TaskTimeCorrectionRequest[] @relation("CorrectionOriginalEntry")

  // Pause Audit Associations
  precedingPauses     TaskTimePause[]             @relation("PausePrecedingEntry")
  followingPauses     TaskTimePause[]             @relation("PauseFollowingEntry")

  @@unique([id, taskId, userId], map: "uq_task_time_entry_id_task_user")
  @@index([taskId, status], map: "idx_task_time_entries_task_status")
  @@index([userId, workDate], map: "idx_task_time_entries_user_date")
  @@index([taskId, status, isSuperseded], map: "idx_task_time_entries_effective")
  @@map("task_time_entries")
}

model TaskTimePause {
  id                   String             @id @default(cuid()) @db.VarChar(30)
  taskId               String             @map("task_id") @db.VarChar(30)
  userId               String             @map("user_id") @db.VarChar(30)
  precedingTimeEntryId String?            @map("preceding_time_entry_id") @db.VarChar(30)
  followingTimeEntryId String?            @map("following_time_entry_id") @db.VarChar(30)
  pausedAt             DateTime           @map("paused_at") @db.DateTime(0)
  resumedAt            DateTime?          @map("resumed_at") @db.DateTime(0)
  pauseDurationSeconds Int                @default(0) @map("pause_duration_seconds")
  reason               TaskPauseReason    @map("reason")
  customDescription    String?            @map("custom_description") @db.VarChar(255)

  // Custom SQL Generated Column (STORED): Guarantees at most 1 open pause per entry
  openPauseEntryId     String?            @unique(map: "uq_one_open_pause_per_entry") @map("open_pause_entry_id") @db.VarChar(30)

  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  task                 Task               @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                 User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  precedingEntry       TaskTimeEntry?     @relation("PausePrecedingEntry", fields: [precedingTimeEntryId, taskId, userId], references: [id, taskId, userId], onDelete: Restrict, onUpdate: Restrict)
  followingEntry       TaskTimeEntry?     @relation("PauseFollowingEntry", fields: [followingTimeEntryId, taskId, userId], references: [id, taskId, userId], onDelete: Restrict, onUpdate: Restrict)

  @@index([taskId], map: "idx_task_time_pauses_task")
  @@index([userId], map: "idx_task_time_pauses_user")
  @@map("task_time_pauses")
}

model TaskTimeCorrectionRequest {
  id                       String                   @id @default(cuid()) @db.VarChar(30)
  taskId                   String                   @map("task_id") @db.VarChar(30)
  userId                   String                   @map("user_id") @db.VarChar(30)
  originalEntryId          String                   @map("original_entry_id") @db.VarChar(30)
  requestedStartedAt       DateTime                 @map("requested_started_at") @db.DateTime(0)
  requestedEndedAt         DateTime                 @map("requested_ended_at") @db.DateTime(0)
  requestedDurationSeconds Int                      @map("requested_duration_seconds")
  reason                   String                   @db.VarChar(500)
  status                   TaskTimeCorrectionStatus @default(PENDING) @map("status")
  reviewedById             String?                  @map("reviewed_by_id") @db.VarChar(30)
  reviewedAt               DateTime?                @map("reviewed_at") @db.DateTime(0)
  rejectionReason          String?                  @map("rejection_reason") @db.VarChar(500)

  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")

  task                     Task                     @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                     User                     @relation("TaskTimeCorrectionRequester", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer                 User?                    @relation("TaskTimeCorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  originalEntry            TaskTimeEntry            @relation("CorrectionOriginalEntry", fields: [originalEntryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultingEntry           TaskTimeEntry?           @relation("CorrectionResultEntry")

  @@index([taskId, status], map: "idx_task_time_corrections_task_status")
  @@index([userId, status], map: "idx_task_time_corrections_user_status")
  @@map("task_time_correction_requests")
}

// =============================================================================
// PHASE 6.3.4: TASK WORKFLOW & COLLABORATION
// =============================================================================

enum TaskReviewOutcome {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

model TaskReview {
  id              String            @id @default(cuid()) @db.VarChar(30)
  taskId          String            @map("task_id") @db.VarChar(30)
  roundNumber     Int               @default(1) @map("round_number")
  reviewerId      String?           @map("reviewer_id") @db.VarChar(30)
  submitterId     String            @map("submitter_id") @db.VarChar(30)
  outcome         TaskReviewOutcome @default(PENDING) @map("outcome")
  feedback        String?           @db.Text
  rating          Int?              @db.SmallInt
  submissionNotes String?           @map("submission_notes") @db.Text
  submittedAt     DateTime          @default(now()) @map("submitted_at")
  reviewedAt      DateTime?         @map("reviewed_at")

  task      Task  @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reviewer  User? @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  submitter User  @relation("TaskSubmitter", fields: [submitterId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([taskId, roundNumber], map: "uq_task_review_round")
  @@index([taskId, outcome], map: "idx_task_reviews_task_outcome")
  @@index([reviewerId, outcome], map: "idx_task_reviews_reviewer_outcome")
  @@map("task_reviews")
}

model TaskComment {
  id              String    @id @default(cuid()) @db.VarChar(30)
  taskId          String    @map("task_id") @db.VarChar(30)
  userId          String    @map("user_id") @db.VarChar(30)
  parentId        String?   @map("parent_id") @db.VarChar(30)
  content         String    @db.Text
  originalContent String?   @map("original_content") @db.Text
  isEdited        Boolean   @default(false) @map("is_edited")
  editedAt        DateTime? @map("edited_at")
  isInternal      Boolean   @default(false) @map("is_internal")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  deletedById     String?   @map("deleted_by_id") @db.VarChar(30)

  task      Task          @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user      User          @relation("UserTaskComments", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deletedBy User?         @relation("CommentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull, onUpdate: Restrict)
  parent    TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  replies   TaskComment[] @relation("CommentReplies")

  @@index([taskId, createdAt], map: "idx_task_comments_task_created")
  @@index([parentId], map: "idx_task_comments_parent")
  @@map("task_comments")
}

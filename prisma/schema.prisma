// Slash Infotech CRM - Prisma schema
// Stack: NestJS + Prisma 6 + MySQL
// Authentication: Email OTP only. No password fields.
// Run: npx prisma format && npx prisma validate

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum OtpPurpose {
  LOGIN
  EMAIL_VERIFICATION
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
  CANCELLED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum DataScope {
  OWN
  ASSIGNED
  DEPARTMENT
  ALL
}

enum MediaType {
  IMAGE
  DOCUMENT
  VIDEO
  OTHER
}

enum MediaStorageProvider {
  LOCAL
  S3
  R2
  OTHER
}

enum MediaVisibility {
  PRIVATE
  PUBLIC
}

enum MediaStatus {
  ACTIVE
  INACTIVE
}

enum MediaScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  QUARANTINED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PERMISSION_CHANGE
  ROLE_ASSIGNMENT
  STATUS_CHANGE
  VERIFY_EVIDENCE
  OTHER
}

// -----------------------------------------------------------------------------
// USER TYPES AND USERS
// -----------------------------------------------------------------------------

model UserType {
  id          String       @id @default(cuid()) @db.VarChar(30)
  code        String       @unique @db.VarChar(40) // SUPER_ADMIN, ADMIN, EMPLOYEE, CLIENT
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(255)
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  users User[]

  @@index([status])
  @@map("user_types")
}

model User {
  id              String       @id @default(cuid()) @db.VarChar(30)
  userCode        String       @unique @map("user_code") @db.VarChar(30)
  userTypeId      String       @map("user_type_id") @db.VarChar(30)
  name            String       @db.VarChar(150)
  email           String       @unique @db.VarChar(191)
  phone           String?      @unique @db.VarChar(25)
  profileMediaId  String?      @unique @map("profile_media_id") @db.VarChar(30)
  emailVerifiedAt DateTime?    @map("email_verified_at")
  status          RecordStatus @default(ACTIVE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.VarChar(30)
  updatedBy String?   @map("updated_by") @db.VarChar(30)
  deletedBy String?   @map("deleted_by") @db.VarChar(30)

  userType UserType @relation(fields: [userTypeId], references: [id], onDelete: Restrict)

  profileMedia Media? @relation("UserProfileMedia", fields: [profileMediaId], references: [id], onDelete: SetNull)

  creator      User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updater      User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  updatedUsers User[] @relation("UserUpdatedBy")
  deleter      User?  @relation("UserDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  deletedUsers User[] @relation("UserDeletedBy")

  employeeProfile EmployeeProfile?
  clientProfile   ClientProfile?
  userRoles       UserRole[]
  userPermissions UserPermission[]
  departments     UserDepartment[]
  otpRequests     OtpRequest[]
  sessions        UserSession[]
  uploadedMedia   Media[]          @relation("MediaUploadedBy")
  activityLogs    ActivityLog[]    @relation("ActivityActor")
  auditLogs       AuditLog[]       @relation("AuditActor")

  attendanceRecords             AttendanceRecord[]
  attendanceSessions            AttendanceSession[]
  attendanceBreaks              AttendanceBreak[]
  employeeCorrections           AttendanceCorrectionRequest[]    @relation("EmployeeCorrections")
  reviewedCorrections           AttendanceCorrectionRequest[]    @relation("ReviewedCorrections")
  employeeOvertimeRequests      AttendanceOvertimeRequest[]      @relation("EmployeeOvertimeRequests")
  reviewedOvertimeRequests      AttendanceOvertimeRequest[]      @relation("ReviewedOvertimeRequests")
  employeeWfhRequests           AttendanceWfhRequest[]           @relation("EmployeeWfhRequests")
  reviewedWfhRequests           AttendanceWfhRequest[]           @relation("ReviewedWfhRequests")
  reviewedEvidenceVerifications AttendanceEvidenceVerification[] @relation("EvidenceReviewer")
  reconciliationRuns            AttendanceReconciliationRun[]    @relation("ReconciliationTriggeredBy")
  resolvedAnomalies             AttendanceRecord[]               @relation("AnomalyResolvedBy")
  resolvedAnomalyItems          AttendanceAnomaly[]              @relation("AnomalyItemResolvedBy")

  createdTasks                    Task[]                  @relation("TaskCreatedBy")
  assignedTasks                   Task[]                  @relation("TaskAssignee")
  assignedByTasks                 Task[]                  @relation("TaskAssignedBy")
  taskAssignmentHistoryPrev       TaskAssignmentHistory[] @relation("TaskPrevAssignee")
  taskAssignmentHistoryNew        TaskAssignmentHistory[] @relation("TaskNewAssignee")
  taskAssignmentHistoryAssignedBy TaskAssignmentHistory[] @relation("TaskHistoryAssignedBy")
  taskStatusHistoryChangedBy      TaskStatusHistory[]     @relation("TaskStatusChangedBy")
  taskActivityLogs                TaskActivityLog[]       @relation("TaskActivityActor")

  taskTimeEntries                 TaskTimeEntry[]
  taskTimePauses                  TaskTimePause[]
  taskTimeCorrectionRequests      TaskTimeCorrectionRequest[] @relation("TaskTimeCorrectionRequester")
  reviewedTimeCorrections         TaskTimeCorrectionRequest[] @relation("TaskTimeCorrectionReviewer")
  reviewedTasks                   TaskReview[]                @relation("TaskReviewer")
  submittedReviews                TaskReview[]                @relation("TaskSubmitter")
  taskComments                    TaskComment[]               @relation("UserTaskComments")
  deletedComments                 TaskComment[]               @relation("CommentDeletedBy")

  @@index([userTypeId, status])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("users")
}

// -----------------------------------------------------------------------------
// USER CODE SEQUENCES
// -----------------------------------------------------------------------------

model UserCodeSequence {
  id           String   @id @default(cuid()) @db.VarChar(30)
  userTypeCode String   @unique @map("user_type_code") @db.VarChar(40)
  prefix       String   @db.VarChar(10) // SA, A, EMP, CLI
  lastNumber   Int      @default(0) @map("last_number")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_code_sequences")
}

// -----------------------------------------------------------------------------
// OTP AUTHENTICATION AND SESSIONS
// -----------------------------------------------------------------------------

model OtpRequest {
  id          String     @id @default(cuid()) @db.VarChar(30)
  userId      String?    @map("user_id") @db.VarChar(30)
  email       String     @db.VarChar(191)
  purpose     OtpPurpose @default(LOGIN)
  otpHash     String     @map("otp_hash") @db.VarChar(255)
  status      OtpStatus  @default(PENDING)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  verifiedAt  DateTime?  @map("verified_at")
  consumedAt  DateTime?  @map("consumed_at")
  requestIp   String?    @map("request_ip") @db.VarChar(45)
  userAgent   String?    @map("user_agent") @db.VarChar(500)
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, purpose, status])
  @@index([userId, createdAt])
  @@index([expiresAt, status])
  @@map("otp_requests")
}

model UserSession {
  id               String        @id @default(cuid()) @db.VarChar(30)
  userId           String        @map("user_id") @db.VarChar(30)
  refreshTokenHash String        @map("refresh_token_hash") @db.VarChar(255)
  status           SessionStatus @default(ACTIVE)
  ipAddress        String?       @map("ip_address") @db.VarChar(45)
  userAgent        String?       @map("user_agent") @db.VarChar(500)
  deviceName       String?       @map("device_name") @db.VarChar(150)
  lastUsedAt       DateTime?     @map("last_used_at")
  expiresAt        DateTime      @map("expires_at")
  revokedAt        DateTime?     @map("revoked_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt, status])
  @@map("user_sessions")
}

// -----------------------------------------------------------------------------
// ROLES AND PERMISSIONS
// -----------------------------------------------------------------------------

model Role {
  id          String       @id @default(cuid()) @db.VarChar(30)
  code        String       @unique @db.VarChar(60) // SUPER_ADMIN, HR, DEVELOPER, etc.
  name        String       @db.VarChar(100)
  description String?      @db.VarChar(255)
  isSystem    Boolean      @default(false) @map("is_system")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  users       UserRole[]
  permissions RolePermission[]

  @@index([status, deletedAt])
  @@map("roles")
}

model Permission {
  id          String       @id @default(cuid()) @db.VarChar(30)
  code        String       @unique @db.VarChar(120) // leads.view, leads.create
  name        String       @db.VarChar(120)
  module      String       @db.VarChar(80)
  action      String       @db.VarChar(60)
  description String?      @db.VarChar(255)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  roles RolePermission[]
  users UserPermission[]

  @@index([module, action])
  @@index([status])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.VarChar(30)
  roleId     String   @map("role_id") @db.VarChar(30)
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.VarChar(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String    @map("role_id") @db.VarChar(30)
  permissionId String    @map("permission_id") @db.VarChar(30)
  dataScope    DataScope @default(ALL) @map("data_scope")
  assignedAt   DateTime  @default(now()) @map("assigned_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserPermission {
  userId       String           @map("user_id") @db.VarChar(30)
  permissionId String           @map("permission_id") @db.VarChar(30)
  effect       PermissionEffect
  dataScope    DataScope?       @map("data_scope")
  reason       String?          @db.VarChar(255)
  assignedBy   String?          @map("assigned_by") @db.VarChar(30)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId, effect])
  @@map("user_permissions")
}

// -----------------------------------------------------------------------------
// DEPARTMENTS AND PROFILES
// -----------------------------------------------------------------------------

model Department {
  id          String       @id @default(cuid()) @db.VarChar(30)
  code        String       @unique @db.VarChar(40)
  name        String       @db.VarChar(120)
  description String?      @db.VarChar(255)
  parentId    String?      @map("parent_id") @db.VarChar(30)
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  deletedAt   DateTime?    @map("deleted_at")

  parent   Department?      @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[]     @relation("DepartmentHierarchy")
  users    UserDepartment[]
  tasks    Task[]

  @@index([parentId, status])
  @@index([deletedAt])
  @@map("departments")
}

model UserDepartment {
  userId       String   @map("user_id") @db.VarChar(30)
  departmentId String   @map("department_id") @db.VarChar(30)
  isPrimary    Boolean  @default(false) @map("is_primary")
  assignedAt   DateTime @default(now()) @map("assigned_at")
  assignedBy   String?  @map("assigned_by") @db.VarChar(30)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  @@id([userId, departmentId])
  @@index([departmentId, isPrimary])
  @@map("user_departments")
}

model EmployeeProfile {
  id             String    @id @default(cuid()) @db.VarChar(30)
  userId         String    @unique @map("user_id") @db.VarChar(30)
  employeeNumber String?   @unique @map("employee_number") @db.VarChar(40)
  designation    String?   @db.VarChar(120)
  dateOfJoining  DateTime? @map("date_of_joining") @db.Date
  employmentType String?   @map("employment_type") @db.VarChar(50)
  reportingToId  String?   @map("reporting_to_id") @db.VarChar(30)
  notes          String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  shiftAssignments EmployeeShiftAssignment[]

  @@unique([id, userId], name: "unique_employee_profile_user")
  @@index([reportingToId])
  @@map("employee_profiles")
}

model ClientProfile {
  id           String   @id @default(cuid()) @db.VarChar(30)
  userId       String   @unique @map("user_id") @db.VarChar(30)
  companyName  String?  @map("company_name") @db.VarChar(180)
  website      String?  @db.VarChar(191)
  taxNumber    String?  @map("tax_number") @db.VarChar(40)
  addressLine1 String?  @map("address_line_1") @db.VarChar(255)
  addressLine2 String?  @map("address_line_2") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  state        String?  @db.VarChar(100)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  country      String?  @db.VarChar(100)
  logoMediaId  String?  @unique @map("logo_media_id") @db.VarChar(30)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  logoMedia Media? @relation("ClientLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@map("client_profiles")
}

// -----------------------------------------------------------------------------
// MEDIA METADATA - actual file bytes live in local/cloud object storage
// -----------------------------------------------------------------------------

model Media {
  id              String               @id @default(cuid()) @db.VarChar(30)
  originalName    String               @map("original_name") @db.VarChar(255)
  storedName      String               @map("stored_name") @db.VarChar(255)
  storageProvider MediaStorageProvider @default(LOCAL) @map("storage_provider")
  storageKey      String               @map("storage_key") @db.VarChar(500)
  fileUrl         String?              @map("file_url") @db.VarChar(1000)
  mimeType        String               @map("mime_type") @db.VarChar(150)
  fileSizeBytes   BigInt               @map("file_size_bytes")
  mediaType       MediaType            @map("media_type")
  visibility      MediaVisibility      @default(PRIVATE)
  status          MediaStatus          @default(ACTIVE)
  uploadedById    String?              @map("uploaded_by_id") @db.VarChar(30)
  checksumSha256  String?              @map("checksum_sha256") @db.VarChar(64)
  scanStatus      MediaScanStatus      @default(PENDING) @map("scan_status")
  scanDetails     String?              @map("scan_details") @db.VarChar(255)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  deletedAt       DateTime?            @map("deleted_at")

  uploadedBy   User?             @relation("MediaUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  profileOf    User?             @relation("UserProfileMedia")
  clientLogoOf ClientProfile?    @relation("ClientLogoMedia")
  attachments  MediaAttachment[]

  @@index([mediaType, status])
  @@index([uploadedById, createdAt])
  @@index([deletedAt])
  @@index([scanStatus])
  @@map("media")
}

model MediaAttachment {
  id         String   @id @default(cuid()) @db.VarChar(30)
  mediaId    String   @map("media_id") @db.VarChar(30)
  entityType String   @map("entity_type") @db.VarChar(80) // e.g. LEAD, PROJECT, TASK
  entityId   String   @map("entity_id") @db.VarChar(30)
  collection String   @default("attachments") @db.VarChar(80)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId, collection])
  @@index([mediaId])
  @@map("media_attachments")
}

// -----------------------------------------------------------------------------
// ACTIVITY AND AUDIT LOGS
// -----------------------------------------------------------------------------

model ActivityLog {
  id          String   @id @default(cuid()) @db.VarChar(30)
  actorUserId String?  @map("actor_user_id") @db.VarChar(30)
  action      String   @db.VarChar(100)
  module      String   @db.VarChar(80)
  entityType  String?  @map("entity_type") @db.VarChar(80)
  entityId    String?  @map("entity_id") @db.VarChar(30)
  description String   @db.VarChar(500)
  metadata    Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([module, createdAt])
  @@index([entityType, entityId])
  @@map("activity_logs")
}

model AuditLog {
  id          String      @id @default(cuid()) @db.VarChar(30)
  actorUserId String?     @map("actor_user_id") @db.VarChar(30)
  action      AuditAction
  module      String      @db.VarChar(80)
  entityType  String      @map("entity_type") @db.VarChar(80)
  entityId    String?     @map("entity_id") @db.VarChar(30)
  oldValues   Json?       @map("old_values")
  newValues   Json?       @map("new_values")
  ipAddress   String?     @map("ip_address") @db.VarChar(45)
  userAgent   String?     @map("user_agent") @db.VarChar(500)
  requestId   String?     @map("request_id") @db.VarChar(100)
  createdAt   DateTime    @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([module, action, createdAt])
  @@index([entityType, entityId])
  @@index([requestId])
  @@map("audit_logs")
}

// =============================================================================
// STAGE 6: EMPLOYEE OPERATIONS - ATTENDANCE SUBSYSTEM
// =============================================================================

enum AttendanceStatus {
  PRESENT
  HALF_DAY
  ABSENT
  ON_LEAVE
  WEEKLY_OFF
  HOLIDAY
  PENDING_RECONCILIATION
}

enum AttendanceSessionStatus {
  ACTIVE
  COMPLETED
  AUTO_CLOSED
  QUARANTINED
  REJECTED
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum OvertimeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum WfhStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReconciliationRunStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  PARTIAL
}

enum VerificationOutcome {
  VERIFIED
  REJECTED
  INCONCLUSIVE
}

enum AnomalyStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

model ShiftDefinition {
  id                       String   @id @default(cuid()) @db.VarChar(30)
  code                     String   @unique @db.VarChar(50)
  name                     String   @db.VarChar(100)
  startTime                String   @map("start_time") @db.VarChar(5) // "09:00"
  endTime                  String   @map("end_time") @db.VarChar(5) // "18:00"
  isOvernight              Boolean  @default(false) @map("is_overnight")
  gracePeriodMinutes       Int      @default(15) @map("grace_period_minutes")
  halfDayThresholdMinutes  Int      @default(240) @map("half_day_threshold_minutes")
  fullDayThresholdMinutes  Int      @default(480) @map("full_day_threshold_minutes")
  overtimeThresholdMinutes Int      @default(540) @map("overtime_threshold_minutes")
  allowMultipleSessions    Boolean  @default(false) @map("allow_multiple_sessions")
  autoCloseGraceMinutes    Int      @default(30) @map("auto_close_grace_minutes")
  breakPolicySnapshot      String   @map("break_policy_snapshot") @db.Text
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  assignments       EmployeeShiftAssignment[]
  attendanceRecords AttendanceRecord[]

  @@map("shift_definitions")
}

model EmployeeShiftAssignment {
  id                String    @id @default(cuid()) @db.VarChar(30)
  employeeProfileId String    @map("employee_profile_id") @db.VarChar(30)
  userId            String    @map("user_id") @db.VarChar(30)
  shiftDefinitionId String    @map("shift_definition_id") @db.VarChar(30)
  startDate         DateTime  @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  employeeProfile   EmployeeProfile    @relation(fields: [employeeProfileId, userId], references: [id, userId], onDelete: Restrict)
  shiftDefinition   ShiftDefinition    @relation(fields: [shiftDefinitionId], references: [id], onDelete: Restrict)
  attendanceRecords AttendanceRecord[]

  @@index([employeeProfileId, userId])
  @@index([userId, startDate, endDate])
  @@index([shiftDefinitionId])
  @@map("employee_shift_assignments")
}

model AttendanceRecord {
  id                String           @id @default(cuid()) @db.VarChar(30)
  userId            String           @map("user_id") @db.VarChar(30)
  shiftAssignmentId String?          @map("shift_assignment_id") @db.VarChar(30)
  shiftDefinitionId String           @map("shift_definition_id") @db.VarChar(30)
  attendanceDate    DateTime         @map("attendance_date") @db.Date
  status            AttendanceStatus @default(PENDING_RECONCILIATION)

  // Historical Snapshots
  shiftStartTimeSnapshot           DateTime @map("shift_start_time_snapshot")
  shiftEndTimeSnapshot             DateTime @map("shift_end_time_snapshot")
  isOvernightSnapshot              Boolean  @default(false) @map("is_overnight_snapshot")
  halfDayThresholdSecondsSnapshot  Int      @map("half_day_threshold_seconds_snapshot")
  fullDayThresholdSecondsSnapshot  Int      @map("full_day_threshold_seconds_snapshot")
  overtimeThresholdSecondsSnapshot Int      @map("overtime_threshold_seconds_snapshot")
  allowMultipleSessionsSnapshot    Boolean  @default(false) @map("allow_multiple_sessions_snapshot")
  breakPolicySnapshot              String   @map("break_policy_snapshot") @db.Text

  // Authoritative Calculated Durations
  grossWorkingDurationSeconds Int @default(0) @map("gross_working_duration_seconds")
  paidBreakDurationSeconds    Int @default(0) @map("paid_break_duration_seconds")
  unpaidBreakDurationSeconds  Int @default(0) @map("unpaid_break_duration_seconds")
  netWorkingDurationSeconds   Int @default(0) @map("net_working_duration_seconds")
  verifiedOvertimeSeconds     Int @default(0) @map("verified_overtime_seconds")

  // Data Integrity & Concurrency Control
  hasIntegrityAnomaly     Boolean @default(false) @map("has_integrity_anomaly")
  anomalyType             String? @map("anomaly_type") @db.VarChar(50)
  anomalyDetails          String? @map("anomaly_details") @db.Text
  version                 Int     @default(1)
  lastCorrectionRequestId String? @map("last_correction_request_id") @db.VarChar(30)

  // Reconciliation & Anomaly Lifecycle
  reconciledAt            DateTime? @map("reconciled_at")
  reconciliationRunId     String?   @map("reconciliation_run_id") @db.VarChar(30)
  anomalyDetectedAt       DateTime? @map("anomaly_detected_at")
  anomalyResolvedAt       DateTime? @map("anomaly_resolved_at")
  anomalyResolvedByUserId String?   @map("anomaly_resolved_by_user_id") @db.VarChar(30)
  anomalyResolutionNotes  String?   @map("anomaly_resolution_notes") @db.VarChar(500)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user              User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  shiftAssignment   EmployeeShiftAssignment?      @relation(fields: [shiftAssignmentId], references: [id], onDelete: SetNull)
  shiftDefinition   ShiftDefinition               @relation(fields: [shiftDefinitionId], references: [id], onDelete: Restrict)
  reconciliationRun AttendanceReconciliationRun?  @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)
  anomalyResolvedBy User?                         @relation("AnomalyResolvedBy", fields: [anomalyResolvedByUserId], references: [id], onDelete: SetNull)
  sessions          AttendanceSession[]
  breaks            AttendanceBreak[]
  corrections       AttendanceCorrectionRequest[]
  anomalies         AttendanceAnomaly[]

  @@unique([id, userId], name: "unique_record_user_composite")
  @@unique([userId, attendanceDate], name: "unique_user_daily_attendance")
  @@index([userId, attendanceDate])
  @@index([shiftAssignmentId])
  @@index([shiftDefinitionId])
  @@index([hasIntegrityAnomaly])
  @@index([reconciliationRunId])
  @@map("attendance_records")
}

model AttendanceSession {
  id                 String @id @default(cuid()) @db.VarChar(30)
  attendanceRecordId String @map("attendance_record_id") @db.VarChar(30)
  userId             String @map("user_id") @db.VarChar(30)

  // Raw Telemetry Preservation
  rawCheckInAt  DateTime  @map("raw_check_in_at")
  rawCheckOutAt DateTime? @map("raw_check_out_at")

  // Authoritative Reconciled Timestamps (Null when QUARANTINED)
  checkInAt       DateTime?               @map("check_in_at")
  checkOutAt      DateTime?               @map("check_out_at")
  durationSeconds Int?                    @map("duration_seconds")
  status          AttendanceSessionStatus @default(ACTIVE)

  isSystemClosed      Boolean @default(false) @map("is_system_closed")
  systemClosureReason String? @map("system_closure_reason") @db.VarChar(255)

  // Virtual generated column for active session concurrency lock
  activeSessionUserId String? @default(dbgenerated()) @map("active_session_user_id") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendanceRecord AttendanceRecord              @relation(fields: [attendanceRecordId, userId], references: [id, userId], onDelete: Cascade)
  user             User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  corrections      AttendanceCorrectionRequest[]

  @@unique([id, attendanceRecordId, userId], name: "unique_session_record_user_composite")
  @@unique([activeSessionUserId], map: "unique_active_session_per_user")
  @@index([attendanceRecordId])
  @@index([userId, status])
  @@map("attendance_sessions")
}

model AttendanceBreak {
  id                 String    @id @default(cuid()) @db.VarChar(30)
  attendanceRecordId String    @map("attendance_record_id") @db.VarChar(30)
  userId             String    @map("user_id") @db.VarChar(30)
  breakTypeId        String    @map("break_type_id") @db.VarChar(50)
  startedAt          DateTime  @map("started_at")
  endedAt            DateTime? @map("ended_at")

  paidDurationSeconds   Int       @default(0) @map("paid_duration_seconds")
  unpaidDurationSeconds Int       @default(0) @map("unpaid_duration_seconds")
  isSystemClosed        Boolean   @default(false) @map("is_system_closed")
  systemClosureReason   String?   @map("system_closure_reason") @db.VarChar(255)
  rawEndedAt            DateTime? @map("raw_ended_at")

  // Virtual generated column for active break concurrency lock
  activeBreakUserId String? @default(dbgenerated()) @map("active_break_user_id") @db.VarChar(30)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId, userId], references: [id, userId], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([id, attendanceRecordId, userId], name: "unique_break_record_user_composite")
  @@unique([activeBreakUserId], map: "unique_active_break_per_user")
  @@index([attendanceRecordId])
  @@index([userId, startedAt])
  @@map("attendance_breaks")
}

model AttendanceCorrectionRequest {
  id                  String  @id @default(cuid()) @db.VarChar(30)
  attendanceRecordId  String  @map("attendance_record_id") @db.VarChar(30)
  userId              String  @map("user_id") @db.VarChar(30)
  attendanceSessionId String? @map("attendance_session_id") @db.VarChar(30)

  requestedCheckInAt  DateTime?                  @map("requested_check_in_at")
  requestedCheckOutAt DateTime?                  @map("requested_check_out_at")
  reason              String                     @db.VarChar(500)
  evidenceMetadata    Json?                      @map("evidence_metadata")
  status              AttendanceCorrectionStatus @default(PENDING)
  reviewedByUserId    String?                    @map("reviewed_by_user_id") @db.VarChar(30)
  reviewedAt          DateTime?                  @map("reviewed_at")
  managerNotes        String?                    @map("manager_notes") @db.VarChar(500)
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  attendanceRecord     AttendanceRecord                @relation(fields: [attendanceRecordId, userId], references: [id, userId], onDelete: Restrict)
  session              AttendanceSession?              @relation(fields: [attendanceSessionId, attendanceRecordId, userId], references: [id, attendanceRecordId, userId], onDelete: Restrict)
  user                 User                            @relation("EmployeeCorrections", fields: [userId], references: [id], onDelete: Restrict)

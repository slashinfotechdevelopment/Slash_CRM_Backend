  triggeredByUserId     String?                 @map("triggered_by_user_id") @db.VarChar(30)
  startedAt             DateTime                @default(now()) @map("started_at")
  completedAt           DateTime?               @map("completed_at")
  notes                 String?                 @db.VarChar(500)
  errorDetails          Json?                   @map("error_details")

  triggeredBy User?               @relation("ReconciliationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  records     AttendanceRecord[]

  reconciliationRunId String?       @map("reconciliation_run_id") @db.VarChar(30)
  anomalyType         String        @map("anomaly_type") @db.VarChar(50)
  details             String?       @db.Text
  status              AnomalyStatus @default(ACTIVE)
  detectedAt          DateTime      @default(now()) @map("detected_at")
  resolvedAt          DateTime?     @map("resolved_at")
  resolvedByUserId    String?       @map("resolved_by_user_id") @db.VarChar(30)
  resolutionNotes     String?       @map("resolution_notes") @db.VarChar(500)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  attendanceRecord  AttendanceRecord             @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)
  reconciliationRun AttendanceReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull)
  resolvedBy        User?                        @relation("AnomalyItemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([attendanceRecordId])
  @@index([anomalyType])
  @@index([status])
  @@map("attendance_anomalies")

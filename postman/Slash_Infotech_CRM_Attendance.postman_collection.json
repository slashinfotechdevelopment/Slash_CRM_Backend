              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"location\": \"Bengaluru HQ Office\",\n  \"remarks\": \"Regular morning punch in\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/attendance/check-in",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "attendance",
                "check-in"
              ]
            },
            "description": "Creates a new active attendance session using server-authoritative UTC timestamps."
          },
          "response": [
            {
              "name": "201 Created - Success",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"success\": true,\n  \"message\": \"Check-in successful.\",\n  \"data\": {\n    \"session\": {\n      \"id\": \"sess_123abc\",\n      \"checkInAt\": \"2026-11-05T03:30:00.000Z\",\n      \"status\": \"ACTIVE\"\n    },\n    \"record\": {\n      \"id\": \"rec_456def\",\n      \"attendanceDate\": \"2026-11-05\",\n      \"status\": \"PENDING_RECONCILIATION\",\n      \"shiftDefinition\": {\n        \"code\": \"SHIFT_STD_9TO6\",\n        \"startTime\": \"09:00\",\n        \"endTime\": \"18:00\"\n      }\n    }\n  }\n}"
            },
            {
              "name": "409 Conflict - Active Session Exists",
              "status": "Conflict",
              "code": 409,
              "body": "{\n  \"statusCode\": 409,\n  \"message\": \"An active attendance session already exists.\",\n  \"error\": \"Conflict\"\n}"
            }
          ]
        },
        {
          "name": "1.2 Check-Out",
